# Static export output. `next.config.ts` sets `output: "export"`, so a build
# writes the whole site here — generated, never committed. The root .gitignore
# already covers `.next/` and `node_modules/`.
/out/

# Incremental TypeScript build cache.
*.tsbuildinfo

# Next's generated ambient types. `next dev` and `next build` each rewrite this
# file to point at their OWN type directory (`.next/dev/types` vs `.next/types`),
# so whichever ran last dirties the tree for the other — it churned through a
# whole session of alternating dev servers and builds before being untracked
# (a7b714e). Untracking it alone leaves it reappearing as an UNTRACKED file on
# the next run, so the ignore rule is the half that makes that stick.
next-env.d.ts
