{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "blockquote",
  "version": "0.1.0",
  "description": "A <blockquote> with a left-stroke accent bar and an optional attribution line. `tone` picks the bar colour (default | accent); `size` scales the quote and citation type together (RFC 0012 D12).",
  "docs": "https://primitiv-ui.dev/docs/components/blockquote",
  "root": {
    "element": "blockquote",
    "class": "primitiv-blockquote"
  },
  "dataAttributes": [],
  "modifiers": [
    {
      "name": "tone",
      "default": "default",
      "description": "Accent-bar colour.",
      "options": [
        { "name": "default", "class": "primitiv-blockquote--default", "description": "Neutral bar (border/strong)." },
        { "name": "accent", "class": "primitiv-blockquote--accent", "description": "Brand bar (border/focus)." }
      ]
    },
    {
      "name": "size",
      "default": "md",
      "description": "Quote + citation size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-blockquote--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-blockquote--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-blockquote--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-blockquote--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-blockquote--xl", "description": "Extra large." }
      ]
    }
  ],
  "subcomponents": [],
  "customProperties": [
    { "name": "--primitiv-blockquote-border-color", "defaultsTo": "var(--primitiv-border-strong)" },
    { "name": "--primitiv-blockquote-border-width", "defaultsTo": "var(--primitiv-border-width-3)" },
    { "name": "--primitiv-blockquote-padding-inline", "defaultsTo": "var(--primitiv-quote-padding-inline)" },
    { "name": "--primitiv-blockquote-gap", "defaultsTo": "var(--primitiv-quote-body-gap-md)" },
    { "name": "--primitiv-blockquote-quote-color", "defaultsTo": "var(--primitiv-content-secondary)" },
    { "name": "--primitiv-blockquote-citation-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-blockquote-font-family", "defaultsTo": "var(--primitiv-body-md-font-family)" },
    { "name": "--primitiv-blockquote-font-size", "defaultsTo": "var(--primitiv-body-md-font-size)" },
    { "name": "--primitiv-blockquote-font-weight", "defaultsTo": "var(--primitiv-body-md-font-weight)" },
    { "name": "--primitiv-blockquote-line-height", "defaultsTo": "var(--primitiv-body-md-line-height)" }
  ]
}
