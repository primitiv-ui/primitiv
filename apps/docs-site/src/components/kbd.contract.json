{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "kbd",
  "version": "0.1.0",
  "description": "A `<kbd>` fragment set in the mono face on a raised, bordered key cap — the physical-keycap sibling of Inline Code. Sized xs–xl so a shortcut tracks the surrounding text; `data-density` scales each size further.",
  "docs": "https://primitiv-ui.dev/docs/components/kbd",
  "root": {
    "element": "kbd",
    "class": "primitiv-kbd"
  },
  "dataAttributes": [],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Key-cap size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-kbd--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-kbd--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-kbd--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-kbd--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-kbd--xl", "description": "Extra large." }
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-kbd-font-family", "defaultsTo": "var(--primitiv-font-family-mono)" },
    { "name": "--primitiv-kbd-font-size", "defaultsTo": "var(--primitiv-body-md-font-size)" },
    { "name": "--primitiv-kbd-line-height", "defaultsTo": "var(--primitiv-code-md-line-height)" },
    { "name": "--primitiv-kbd-color", "defaultsTo": "var(--primitiv-content-primary)" },
    { "name": "--primitiv-kbd-background", "defaultsTo": "var(--primitiv-surface-raised)" },
    { "name": "--primitiv-kbd-border-color", "defaultsTo": "var(--primitiv-border-default)" },
    { "name": "--primitiv-kbd-border-width", "defaultsTo": "var(--primitiv-border-width-1)" },
    { "name": "--primitiv-kbd-radius", "defaultsTo": "var(--primitiv-radii-4)" },
    { "name": "--primitiv-kbd-padding-inline", "defaultsTo": "var(--primitiv-code-inline-padding-inline)" },
    { "name": "--primitiv-kbd-padding-block", "defaultsTo": "var(--primitiv-code-inline-padding-block)" }
  ]
}
