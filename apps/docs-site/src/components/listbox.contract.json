{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "listbox",
  "version": "0.1.0",
  "description": "A persistently-visible list of selectable options implementing the WAI-ARIA APG listbox pattern. Unlike `select`, this list is always on screen with no trigger and no popup, and its cursor is a virtual-focus position (`aria-activedescendant` on the root, `data-highlighted` on the option) rather than DOM focus — which is what lets a separate control, such as a search input or a command palette's text field, hold focus and drive the list at the same time. Framed like a form control on Input's geometry, with rows resolving the shared dropdown tokens so a listbox and a menu are the same surface. Keyboard, typeahead, cursor and selection are owned by the headless primitive.",
  "docs": "https://primitiv-ui.dev/docs/components/listbox",
  "root": {
    "element": "div",
    "class": "primitiv-listbox",
    "component": "Listbox"
  },
  "dataAttributes": [
    { "name": "data-orientation", "value": "vertical", "when": "vertical (the default)", "source": "auto" },
    { "name": "data-orientation", "value": "horizontal", "when": "horizontal", "source": "auto" },
    { "name": "aria-invalid", "value": "true", "when": "invalid — set it yourself; there is no `invalid` prop", "source": "consumer" },
    { "name": "aria-activedescendant", "value": "<option id>", "when": "the cursor is on an option", "source": "auto" },
    { "name": "aria-selected", "value": "true", "when": "selected option", "source": "auto" },
    { "name": "aria-selected", "value": "false", "when": "unselected option", "source": "auto" },
    { "name": "data-highlighted", "value": "", "when": "the cursor is on this option", "source": "auto" },
    { "name": "data-disabled", "value": "", "when": "disabled option", "source": "auto" }
  ],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Frame + row scale; `data-density` scales the sizing within each size. Re-points the frame (radius, padding, focus-ring geometry) and every row knob (height/padding/gap/radius/icon) plus the typography.",
      "options": [
        { "name": "xs", "class": "primitiv-listbox--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-listbox--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-listbox--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-listbox--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-listbox--xl", "description": "Extra large." }
      ]
    }
  ],
  "subcomponents": [
    { "name": "option", "component": "Option", "element": "div", "class": "primitiv-listbox__option" },
    { "name": "option-indicator", "component": "OptionIndicator", "element": "span", "class": "primitiv-listbox__option-indicator" },
    { "name": "option-checkbox", "component": "OptionCheckbox", "element": "span", "class": "primitiv-listbox__option-checkbox" },
    { "name": "option-leading", "component": "OptionLeading", "element": "span", "class": "primitiv-listbox__option-leading" },
    { "name": "option-label", "component": "OptionLabel", "element": "span", "class": "primitiv-listbox__option-label" },
    { "name": "option-trailing", "component": "OptionTrailing", "element": "span", "class": "primitiv-listbox__option-trailing" },
    { "name": "group", "component": "Group", "element": "div", "class": "primitiv-listbox__group" },
    { "name": "group-label", "component": "GroupLabel", "element": "div", "class": "primitiv-listbox__group-label" },
    { "name": "empty", "component": "Empty", "element": "div", "class": "primitiv-listbox__empty" }
  ],
  "customProperties": [
    { "name": "--primitiv-listbox-surface", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-listbox-fg", "defaultsTo": "var(--primitiv-content-primary)" },
    { "name": "--primitiv-listbox-border-width", "defaultsTo": "var(--primitiv-border-width-1)" },
    { "name": "--primitiv-listbox-border-color", "defaultsTo": "var(--primitiv-border-default)" },
    { "name": "--primitiv-listbox-border-color-invalid", "defaultsTo": "var(--primitiv-border-invalid)" },
    { "name": "--primitiv-listbox-radius", "defaultsTo": "var(--primitiv-framed-control-md-radius)" },
    { "name": "--primitiv-listbox-padding-block", "defaultsTo": "var(--primitiv-dropdown-md-panel-padding-block)" },
    { "name": "--primitiv-listbox-padding-inline", "defaultsTo": "var(--primitiv-space-space-4)" },
    { "name": "--primitiv-listbox-max-block-size", "defaultsTo": "18rem" },
    { "name": "--primitiv-listbox-ring-color", "defaultsTo": "var(--primitiv-border-focus)" },
    { "name": "--primitiv-listbox-ring-width", "defaultsTo": "var(--primitiv-focus-ring-width)" },
    { "name": "--primitiv-listbox-ring-offset", "defaultsTo": "var(--primitiv-focus-ring-offset)" },
    { "name": "--primitiv-listbox-option-height", "defaultsTo": "var(--primitiv-dropdown-md-item-height)" },
    { "name": "--primitiv-listbox-option-padding-inline", "defaultsTo": "var(--primitiv-dropdown-md-item-padding-inline)" },
    { "name": "--primitiv-listbox-option-gap", "defaultsTo": "var(--primitiv-dropdown-md-item-gap)" },
    { "name": "--primitiv-listbox-option-radius", "defaultsTo": "var(--primitiv-dropdown-md-item-radius)" },
    { "name": "--primitiv-listbox-option-icon-size", "defaultsTo": "var(--primitiv-dropdown-md-item-icon-size)" },
    { "name": "--primitiv-listbox-option-font-family", "defaultsTo": "var(--primitiv-body-sm-font-family)" },
    { "name": "--primitiv-listbox-option-font-size", "defaultsTo": "var(--primitiv-dropdown-md-item-font-size)" },
    { "name": "--primitiv-listbox-option-font-weight", "defaultsTo": "var(--primitiv-body-sm-font-weight)" },
    { "name": "--primitiv-listbox-option-line-height", "defaultsTo": "var(--primitiv-dropdown-md-item-line-height)" },
    { "name": "--primitiv-listbox-option-color", "defaultsTo": "var(--primitiv-content-primary)" },
    { "name": "--primitiv-listbox-option-color-disabled", "defaultsTo": "var(--primitiv-content-disabled)" },
    { "name": "--primitiv-listbox-option-bg", "defaultsTo": "var(--primitiv-color-transparent)" },
    { "name": "--primitiv-listbox-option-bg-hover", "defaultsTo": "var(--primitiv-action-ghost-hover)" },
    { "name": "--primitiv-listbox-option-bg-highlighted", "defaultsTo": "var(--primitiv-action-secondary-default)" },
    { "name": "--primitiv-listbox-option-spacing", "defaultsTo": "calc(var(--primitiv-listbox-option-gap) / 2)" },
    { "name": "--primitiv-listbox-indicator-color", "defaultsTo": "var(--primitiv-content-primary)" },
    { "name": "--primitiv-listbox-checkbox-size", "defaultsTo": "var(--primitiv-checkbox-md-box-size)" },
    { "name": "--primitiv-listbox-checkbox-radius", "defaultsTo": "var(--primitiv-checkbox-md-box-radius)" },
    { "name": "--primitiv-listbox-checkbox-mark-size", "defaultsTo": "var(--primitiv-checkbox-md-mark-size)" },
    { "name": "--primitiv-listbox-checkbox-bg", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-listbox-checkbox-bg-selected", "defaultsTo": "var(--primitiv-action-primary-default)" },
    { "name": "--primitiv-listbox-checkbox-border-width", "defaultsTo": "var(--primitiv-border-width-1)" },
    { "name": "--primitiv-listbox-checkbox-border-color", "defaultsTo": "var(--primitiv-border-strong)" },
    { "name": "--primitiv-listbox-checkbox-border-color-selected", "defaultsTo": "var(--primitiv-action-primary-default)" },
    { "name": "--primitiv-listbox-checkbox-mark-color", "defaultsTo": "var(--primitiv-action-primary-foreground-default)" },
    { "name": "--primitiv-listbox-group-label-height", "defaultsTo": "var(--primitiv-dropdown-md-label-height)" },
    { "name": "--primitiv-listbox-group-label-padding-inline", "defaultsTo": "var(--primitiv-dropdown-md-label-padding-inline)" },
    { "name": "--primitiv-listbox-group-label-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-listbox-group-label-font-family", "defaultsTo": "var(--primitiv-label-xs-font-family)" },
    { "name": "--primitiv-listbox-group-label-font-size", "defaultsTo": "var(--primitiv-label-xs-font-size)" },
    { "name": "--primitiv-listbox-group-label-font-weight", "defaultsTo": "var(--primitiv-label-xs-font-weight)" },
    { "name": "--primitiv-listbox-group-label-line-height", "defaultsTo": "var(--primitiv-label-xs-line-height)" },
    { "name": "--primitiv-listbox-group-label-letter-spacing", "defaultsTo": "var(--primitiv-letter-spacing-wide)" },
    { "name": "--primitiv-listbox-empty-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-listbox-empty-min-block-size", "defaultsTo": "calc(var(--primitiv-listbox-option-height) * 2)" },
    { "name": "--primitiv-listbox-label-ink-slack", "defaultsTo": "var(--primitiv-space-space-1)" }
  ]
}
