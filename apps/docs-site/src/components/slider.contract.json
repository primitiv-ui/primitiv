{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "slider",
  "version": "0.1.0",
  "description": "A draggable, keyboard-accessible control for selecting one value (or a range) along a track.",
  "docs": "https://primitiv-ui.dev/docs/components/slider",
  "root": {
    "element": "span",
    "class": "primitiv-slider",
    "component": "Root"
  },
  "dataAttributes": [
    { "name": "data-orientation", "value": "horizontal", "when": "horizontal", "source": "auto" },
    { "name": "data-orientation", "value": "vertical", "when": "vertical", "source": "auto" },
    { "name": "data-disabled", "value": "", "when": "disabled", "source": "auto" }
  ],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Track thickness + thumb size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-slider--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-slider--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-slider--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-slider--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-slider--xl", "description": "Extra large." }
      ]
    }
  ],
  "subcomponents": [
    {
      "name": "track",
      "component": "Track",
      "class": "primitiv-slider__track",
      "dataAttributes": [
        { "name": "data-orientation", "value": "horizontal", "when": "horizontal", "source": "auto" },
        { "name": "data-orientation", "value": "vertical", "when": "vertical", "source": "auto" },
        { "name": "data-disabled", "value": "", "when": "disabled", "source": "auto" }
      ]
    },
    {
      "name": "range",
      "component": "Range",
      "class": "primitiv-slider__range",
      "dataAttributes": [
        { "name": "data-orientation", "value": "horizontal", "when": "horizontal", "source": "auto" },
        { "name": "data-orientation", "value": "vertical", "when": "vertical", "source": "auto" },
        { "name": "data-disabled", "value": "", "when": "disabled", "source": "auto" }
      ]
    },
    {
      "name": "thumb",
      "component": "Thumb",
      "class": "primitiv-slider__thumb",
      "dataAttributes": [
        { "name": "data-orientation", "value": "horizontal", "when": "horizontal", "source": "auto" },
        { "name": "data-orientation", "value": "vertical", "when": "vertical", "source": "auto" },
        { "name": "data-disabled", "value": "", "when": "disabled", "source": "auto" }
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-slider-track-thickness", "defaultsTo": "var(--primitiv-slider-md-track-thickness)" },
    { "name": "--primitiv-slider-track-bg", "defaultsTo": "var(--primitiv-action-secondary-border-default)" },
    { "name": "--primitiv-slider-range-bg", "defaultsTo": "var(--primitiv-action-primary-default)" },
    { "name": "--primitiv-slider-thumb-size", "defaultsTo": "var(--primitiv-slider-md-thumb-size)" },
    { "name": "--primitiv-slider-thumb-bg", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-slider-thumb-border-color", "defaultsTo": "var(--primitiv-action-secondary-border-default)" },
    { "name": "--primitiv-slider-thumb-border-width", "defaultsTo": "var(--primitiv-framed-control-border-width)" },
    { "name": "--primitiv-slider-thumb-ring-gap-size", "defaultsTo": "var(--primitiv-slider-md-thumb-ring-gap-size)" },
    { "name": "--primitiv-slider-thumb-ring-size", "defaultsTo": "var(--primitiv-slider-md-thumb-ring-size)" },
    { "name": "--primitiv-slider-thumb-glow-color", "defaultsTo": "var(--primitiv-action-primary-default)" },
    { "name": "--primitiv-slider-thumb-glow-opacity", "defaultsTo": "var(--primitiv-opacity-20)" }
  ]
}
