    "importPath": "@/components/ui/aspect-ratio",
    "subComponents": [
      {
        "name": "AspectRatio",
        "extends": "HTMLDivElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "ratio",
            "type": "\"1/1\" | \"4/3\" | \"3/2\" | \"16/9\" | \"21/9\" | \"3/4\" | \"2/3\" | \"9/16\"",
            "default": "1/1",
            "description": "Width-to-height ratio, from a curated preset set. A bespoke ratio is set by overriding the `--primitiv-aspect-ratio` custom property in your own stylesheet — the component writes no inline styles.",
