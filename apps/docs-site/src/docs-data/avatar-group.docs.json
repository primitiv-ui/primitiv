{
  "id": "avatar-group",
  "displayName": "AvatarGroup",
  "kind": "registry-only",
  "status": "stable",
  "category": "Data Display",
  "description": "An overlapping row of Avatars with an optional \"+N\" overflow counter — the collaborators/attendees pattern. Composes the registry `avatar` component; the counter is itself an Avatar, not a Badge. Sized xs–xl; `data-density` scales each size further.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@/components/ui/avatar-group",
    "subComponents": [
      {
        "name": "AvatarGroup",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The `Avatar` elements."
          },
          {
            "name": "max",
            "type": "number",
            "required": false,
            "default": null,
            "description": "Show at most this many faces, replacing the remainder with a `+N`\ncounter. Omit to show every child and no counter."
          },
          {
            "name": "overflowLabel",
            "type": "(count: number) => string",
            "required": false,
            "default": "(n) => `${n} more`",
            "description": "Accessible label for the overflow counter, given the count. The counter\nis decorative-by-default otherwise."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Matches the nested Avatars' size; `data-density` scales each size further.",
            "classes": {
              "xs": "primitiv-avatar-group--xs",
              "sm": "primitiv-avatar-group--sm",
              "md": "primitiv-avatar-group--md",
              "lg": "primitiv-avatar-group--lg",
              "xl": "primitiv-avatar-group--xl"
            }
          },
          {
            "name": "direction",
            "type": "\"ltr\" | \"rtl\"",
            "default": "ltr",
            "description": "Which way the stack advances. Decides which end the counter lands on.",
            "classes": {
              "ltr": "primitiv-avatar-group--ltr",
              "rtl": "primitiv-avatar-group--rtl"
            }
          }
        ],
        "dataAttributes": [],
        "class": "primitiv-avatar-group"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add avatar-group",
    "rootClass": "primitiv-avatar-group",
    "customProperties": [
      {
        "name": "--primitiv-avatar-group-overlap",
        "defaultsTo": "var(--primitiv-avatar-group-md-overlap)"
      },
      {
        "name": "--primitiv-avatar-group-ring-width",
        "defaultsTo": "var(--primitiv-avatar-group-md-ring-width)"
      },
      {
        "name": "--primitiv-avatar-group-ring-color",
        "defaultsTo": "var(--primitiv-surface-default)"
      }
    ],
    "dataAttributes": []
  },
  "figma": {
    "componentSetKey": "1480:44052"
  },
  "elements": {
    "package": null,
    "module": "avatar-group",
    "version": null,
    "element": "div",
    "wrapText": false,
    "example": "<div class=\"primitiv-avatar-group primitiv-avatar-group--md primitiv-avatar-group--ltr\">\n  <span class=\"primitiv-avatar-group__item\" style=\"z-index: 3\">\n    <span class=\"primitiv-avatar primitiv-avatar--md primitiv-avatar--circle\"><span class=\"primitiv-avatar__fallback\"><span class=\"primitiv-avatar__fallback-label\">AL</span></span></span>\n  </span>\n  <span class=\"primitiv-avatar-group__item\" style=\"z-index: 2\">\n    <span class=\"primitiv-avatar primitiv-avatar--md primitiv-avatar--circle\"><span class=\"primitiv-avatar__fallback\"><span class=\"primitiv-avatar__fallback-label\">GH</span></span></span>\n  </span>\n  <span class=\"primitiv-avatar-group__item\" style=\"z-index: 1\">\n    <span class=\"primitiv-avatar primitiv-avatar--md primitiv-avatar--circle\"><span class=\"primitiv-avatar__fallback\"><span class=\"primitiv-avatar__fallback-label\">KJ</span></span></span>\n  </span>\n  <span class=\"primitiv-avatar-group__item primitiv-avatar-group__item--counter\">\n    <span class=\"primitiv-avatar primitiv-avatar--md primitiv-avatar--circle primitiv-avatar-group__counter\"><span class=\"primitiv-avatar__fallback\" aria-label=\"4 more\"><span class=\"primitiv-avatar__fallback-label\">+4</span></span></span>\n  </span>\n</div>\n",
    "api": []
  }
}
