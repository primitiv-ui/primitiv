{
  "id": "breadcrumb-overflow",
  "displayName": "BreadcrumbOverflow",
  "kind": "registry-only",
  "status": "stable",
  "category": "Disclosure",
  "description": "A Breadcrumb trail that collapses its middle entries behind an overflow menu once the trail exceeds keepStart + keepEnd items.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@/components/ui/breadcrumb-overflow",
    "subComponents": [
      {
        "name": "BreadcrumbOverflow",
        "extends": "HTMLElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The trail's `BreadcrumbLink` / `BreadcrumbPage` elements, in order."
          },
          {
            "name": "keepEnd",
            "type": "number",
            "required": false,
            "default": "1",
            "description": "How many crumbs to always show at the end of the trail (typically\nincluding the current page) after the overflow menu."
          },
          {
            "name": "keepStart",
            "type": "number",
            "required": false,
            "default": "1",
            "description": "How many crumbs to always show at the start of the trail before the\noverflow menu."
          },
          {
            "name": "menuLabel",
            "type": "string",
            "required": false,
            "default": "\"Show hidden pages\"",
            "description": "Accessible label for the overflow trigger button."
          },
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "required": false,
            "default": "\"md\"",
            "description": "Matches `Breadcrumb`'s own size; also sizes the overflow trigger button\nand the menu it opens."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb-overflow"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add breadcrumb-overflow",
    "rootClass": "primitiv-breadcrumb-overflow",
    "customProperties": [
      {
        "name": "--primitiv-breadcrumb-overflow-trigger-hover-background",
        "defaultsTo": "var(--primitiv-action-ghost-hover)"
      },
      {
        "name": "--primitiv-breadcrumb-overflow-trigger-active-background",
        "defaultsTo": "var(--primitiv-action-ghost-active)"
      }
    ],
    "dataAttributes": []
  },
  "figma": {
    "componentSetKey": "436:12911"
  },
  "elements": {
    "package": "@primitiv-ui/web",
    "module": "dropdown",
    "version": "0.1.57",
    "element": "nav",
    "wrapText": false,
    "example": "<nav aria-label=\"Breadcrumb\" class=\"primitiv-breadcrumb primitiv-breadcrumb--md primitiv-breadcrumb-overflow\">\n  <ol class=\"primitiv-breadcrumb__list\">\n    <li class=\"primitiv-breadcrumb__item\"><a class=\"primitiv-breadcrumb__link\" href=\"/\">Home</a></li>\n    <li class=\"primitiv-breadcrumb__separator\" role=\"presentation\" aria-hidden=\"true\">/</li>\n    <li class=\"primitiv-breadcrumb__item\">\n      <primitiv-dropdown>\n        <primitiv-dropdown-trigger>\n          <button type=\"button\" class=\"primitiv-breadcrumb-overflow__trigger\" aria-label=\"Show hidden pages\"><span class=\"primitiv-breadcrumb__ellipsis\" role=\"presentation\" aria-hidden=\"true\">...</span></button>\n        </primitiv-dropdown-trigger>\n        <primitiv-dropdown-content class=\"primitiv-dropdown primitiv-dropdown--md primitiv-dropdown--bottom-start\" popover=\"auto\">\n          <primitiv-dropdown-item><a class=\"primitiv-breadcrumb__link primitiv-dropdown__item\" href=\"/library\">Library</a></primitiv-dropdown-item>\n          <primitiv-dropdown-item><a class=\"primitiv-breadcrumb__link primitiv-dropdown__item\" href=\"/library/fiction\">Fiction</a></primitiv-dropdown-item>\n          <primitiv-dropdown-item><a class=\"primitiv-breadcrumb__link primitiv-dropdown__item\" href=\"/library/fiction/mystery\">Mystery</a></primitiv-dropdown-item>\n        </primitiv-dropdown-content>\n      </primitiv-dropdown>\n    </li>\n    <li class=\"primitiv-breadcrumb__separator\" role=\"presentation\" aria-hidden=\"true\">/</li>\n    <li class=\"primitiv-breadcrumb__item\"><span class=\"primitiv-breadcrumb__page\" aria-current=\"page\">Neuromancer</span></li>\n  </ol>\n</nav>\n",
    "api": [
