        "attributes": [
          {
            "name": "open",
            "type": "boolean",
            "description": "Whether the menu is open. Reflected: it changes as the user opens and dismisses it. Set it (or the `open` property) to open or close it from script."
          }
        ],
        "events": [
          {
            "name": "primitiv-dropdown-change",
            "type": "CustomEvent<{ open: boolean }>",
            "description": "Bubbles, cancelable, fired before a user-driven change is applied — the trigger, Escape, a press outside or a chosen item — with the open state afterwards. Call `preventDefault()` to veto it."
          },
          {
            "name": "primitiv-dropdown-select",
            "type": "CustomEvent<null>",
