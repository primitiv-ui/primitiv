  "elements": {
    "package": "@primitiv-ui/web",
    "module": "collapsible",
    "element": "div",
    "wrapText": false,
    "example": "<primitiv-collapsible class=\"primitiv-collapsible primitiv-collapsible--card primitiv-collapsible--md\">\n  <primitiv-collapsible-trigger>\n    <button type=\"button\" class=\"primitiv-collapsible__trigger\">\n      <span class=\"primitiv-collapsible__trigger-label\">Show shipping details</span>\n      <primitiv-collapsible-trigger-icon class=\"primitiv-collapsible__trigger-icon\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20.06 9 12 17.06 3.94 9 5 7.94l7 7 7-7L20.06 9Z\"/></svg></primitiv-collapsible-trigger-icon>\n    </button>\n  </primitiv-collapsible-trigger>\n  <primitiv-collapsible-content class=\"primitiv-collapsible__content\" hidden>\n    <span class=\"primitiv-collapsible__content-inner\"><span class=\"primitiv-collapsible__content-body\">Orders ship within two business days. Tracking details arrive by email once the parcel leaves the warehouse.</span><span class=\"primitiv-collapsible__content-fade\"></span></span>\n  </primitiv-collapsible-content>\n</primitiv-collapsible>\n",
    "api": [
      {
        "tag": "primitiv-collapsible",
        "description": "`<primitiv-collapsible>` — the state owner of a single disclosure: a trigger that shows and hides one panel.\n\nThe root finds its own parts, so a collapsible nested in a panel keeps its own, and reconciles their ARIA from its reflected state whenever a part arrives, leaves, or changes an attribute the root reads (the lifecycle is `PrimitivRootElement`'s).",
        "attributes": [
          {
            "name": "open",
            "type": "boolean",
            "description": "Whether the panel is open. Reflected: it changes as the user toggles, so a server re-render or a history snapshot sees the live state."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "description": "Disables the collapsible: the trigger's button stays focusable, is marked `aria-disabled`, and never toggles."
          }
        ],
        "events": [
          {
            "name": "primitiv-collapsible-change",
            "type": "CustomEvent<{ open: boolean }>",
            "description": "Bubbles, cancelable, fired before a user-driven toggle is applied, with the open state afterwards. Call `preventDefault()` to veto it."
          }
        ]
      },
      {
        "tag": "primitiv-collapsible-trigger",
        "description": "`<primitiv-collapsible-trigger>` — an interactive part. It decorates exactly one child the consumer writes, a `<button>`, which receives `aria-expanded`, `aria-controls` and the state attributes, so the rendered DOM matches React's `<button aria-expanded>` (RFC 0033 D24).",
        "attributes": [],
        "events": []
      },
      {
        "tag": "primitiv-collapsible-content",
        "description": "`<primitiv-collapsible-content>` — the panel. Structural: the root writes its id and state and hides it while closed.",
        "attributes": [
          {
            "name": "force-mount",
            "type": "boolean",
            "description": "Never sets `hidden`, so styles can animate the panel open and closed. A closed panel always carries `aria-hidden`, so it stays out of the accessibility tree either way."
          },
          {
            "name": "collapsed-height",
            "type": "string",
            "description": "Shows a clamped preview while closed instead of hiding the panel (the read-more pattern). A bare number is pixels; anything else is a CSS length, used verbatim. Published as the `--primitiv-collapsible-collapsed-height` custom property, with `data-clamped=\"true\"`; the panel is never hidden, since the preview is real content."
          }
        ],
        "events": [
          {
            "name": "primitiv-collapsible-show",
            "type": "CustomEvent",
            "description": "Bubbles from the panel as it opens (not on first render), so a lazy panel can fetch its content."
          }
        ]
      },
      {
        "tag": "primitiv-collapsible-trigger-icon",
        "description": "`<primitiv-collapsible-trigger-icon>` — a decorative indicator, usually inside the trigger's button. The root hides it from assistive technology and mirrors the `data-state`, for a chevron that flips.",
        "attributes": [],
        "events": []
      }
    ]
  }
}
