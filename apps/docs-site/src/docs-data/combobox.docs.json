        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-combobox__content"
      },
      {
        "name": "Combobox.Item",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "value",
            "type": "string",
            "required": true,
            "default": null,
            "description": "The value committed when this item is chosen. This narrows the native\n`value` attribute, so `value` is `Omit`-ted from the base props above —\nwithout that the two resolve to an intersection artifact that leaks into\nconsumer types and the generated prop tables."
          },
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's own element instead of the default one, merging\nbehaviour onto it."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
