{
  "id": "combobox",
  "displayName": "Combobox",
  "kind": "registry",
  "status": "stable",
  "category": "Collections & Selection",
  "description": "An editable text field with a filtered popup listbox, implementing the WAI-ARIA APG combobox pattern. The control is Input verbatim — same `framed-control/{size}/*` geometry, same states — wrapped so a trailing chevron can sit beside the field, and the popup is a floating panel at `elevation/overlay` whose rows resolve the shared dropdown tokens, so a combobox listbox and a menu are the same surface. Filtering is consumer-owned: there is no `filter` prop. Keyboard, virtual-focus cursor, the query/value split and the open state all belong to the headless primitive.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Combobox.Root",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's own element instead of the default one, merging\nbehaviour onto it."
          },
          {
            "name": "defaultOpen",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Whether the popup is open on first render, for the uncontrolled case."
          },
          {
            "name": "defaultValue",
            "type": "string",
            "required": false,
            "default": "\"\"",
            "description": "The selected value on first render, for the uncontrolled case."
          },
          {
            "name": "onOpenChange",
            "type": "(open: boolean) => void",
            "required": false,
            "default": "undefined",
            "description": "Called when the combobox wants the popup opened or closed. Under a\ncontrolled {@link ComboboxRootProps.open`open`} the combobox only asks —\nthe parent decides."
          },
          {
            "name": "onQueryChange",
            "type": "(query: string) => void",
            "required": false,
            "default": "undefined",
            "description": "Called with the input's text on every keystroke. Filtering is\n**consumer-owned** — narrow the options you render in response. The\ncomponent deliberately ships no `filter` prop."
          },
          {
            "name": "onValueChange",
            "type": "(value: string) => void",
            "required": false,
            "default": "undefined",
            "description": "Called with the newly selected value when the user commits a choice,\nwhether by click or by Enter."
          },
          {
            "name": "open",
            "type": "boolean",
            "required": false,
            "default": "undefined",
            "description": "Whether the popup is open, for the controlled case. Pair with\n{@link ComboboxRootProps.onOpenChange`onOpenChange`} or it can never\nchange."
          },
          {
            "name": "value",
            "type": "string",
            "required": false,
            "default": "undefined",
            "description": "The selected value, for the controlled case. Pair with\n{@link ComboboxRootProps.onValueChange`onValueChange`}."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control + panel + row scale, set once on the root and inherited by every part; `data-density` scales the sizing within each size. Re-points the control's framed-control knobs, the panel's dropdown geometry and every row knob plus the typography."
          }
        ],
        "dataAttributes": [
          {
            "name": "aria-expanded",
            "value": "true",
            "when": "the popup is open"
          },
          {
            "name": "aria-expanded",
            "value": "false",
            "when": "the popup is closed"
          },
          {
            "name": "aria-activedescendant",
            "value": "<item id>",
            "when": "the cursor sits on an item"
          },
          {
            "name": "aria-selected",
            "value": "true",
            "when": "the committed item"
          },
          {
            "name": "aria-selected",
            "value": "false",
            "when": "an uncommitted item"
          },
          {
            "name": "data-highlighted",
            "value": "",
            "when": "the cursor sits on this item"
          },
          {
            "name": "aria-invalid",
            "value": "true",
            "when": "invalid — set it on the input yourself, or cascade it from a Field.Root; there is no `invalid` prop"
          }
        ],
        "class": "primitiv-combobox"
      },
      {
        "name": "Combobox.Control",
        "extends": "HTMLDivElement",
        "props": [],
        "styledOnly": true,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-combobox__control"
      },
      {
