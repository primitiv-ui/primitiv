{
  "id": "modal",
  "displayName": "Modal",
  "kind": "registry",
  "status": "stable",
  "category": "Overlays",
  "description": "An accessible modal dialog built on the native `<dialog>` element — a fixed-width surface with an optional dimmed backdrop (WAI-ARIA Modal Dialog pattern).",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Modal.Root",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The modal's sub-components (Trigger, Portal, Overlay, Content, ...)."
          },
          {
            "name": "defaultOpen",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Whether the modal is open on first render. The component owns the flag\nfrom then on. Omit for closed-on-mount.\nForbidden in controlled mode — use `open` instead."
          },
          {
            "name": "onOpenChange",
            "type": "(open: boolean) => void",
            "required": false,
            "default": null,
            "description": "Called with the new open state whenever it changes (open or close).\nOptional in uncontrolled mode — useful purely to observe transitions.\nCalled with the requested open state whenever the modal wants to open or\nclose (trigger click, Close button, Esc, click-outside, imperative API).\nRequired in controlled mode."
          },
          {
            "name": "open",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Forbidden in uncontrolled mode — use `defaultOpen` instead.\nThe current open state. Must be kept in sync by the parent via `onOpenChange`."
          },
          {
            "name": "ref",
            "type": "Ref<ModalImperativeApi>",
            "required": false,
            "default": null,
            "description": "Ref receiving the imperative {@link ModalImperativeApiopen/close handle}."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": null
      },
      {
        "name": "Modal.Trigger",
        "extends": "HTMLButtonElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render into the consumer's own element (e.g. a router `<Link>`) instead\nof the default `<button>`, merging the trigger's ARIA wiring, composed\nevent handlers, and ref onto it via the Slot pattern."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": null
      },
      {
        "name": "Modal.Portal",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The dialog subtree to portal — typically `Modal.Overlay` + `Modal.Content`."
          },
          {
            "name": "container",
            "type": "HTMLElement",
            "required": false,
            "default": "document.body",
            "description": "Target element to portal into."
          },
          {
            "name": "forceMount",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Keep the portalled subtree mounted after `open` flips false, so a CSS\nexit animation keyed off `data-state=\"closed\"` can play. Without it the\nportal unmounts as soon as the modal closes."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": null
      },
      {
        "name": "Modal.Overlay",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render into the consumer's own element (e.g. a motion wrapper) instead of\nthe default `<div>`, merging the overlay's `aria-hidden` and `data-state`\nonto it via the Slot pattern."
          },
          {
            "name": "forceMount",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Keep the overlay mounted after `open` flips false so a CSS fade-out can\nplay. Without it the overlay unmounts as soon as the modal closes."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [
          {
            "name": "data-state",
            "value": "open",
            "when": "open"
          },
          {
            "name": "data-state",
            "value": "closed",
            "when": "closed"
          }
        ],
        "class": "primitiv-modal__overlay"
      },
      {
        "name": "Modal.Content",
        "extends": "HTMLDialogElement",
        "props": [
          {
            "name": "onEscapeKeyDown",
            "type": "(event: Event) => void",
            "required": false,
            "default": null,
            "description": "Fires on the dialog's native `cancel` event when the user presses\nEscape. Call `event.preventDefault()` to veto closing and keep the\nmodal open (e.g. to confirm unsaved changes first)."
          },
          {
            "name": "onPointerDownOutside",
            "type": "(event: PointerEvent) => void",
            "required": false,
            "default": null,
            "description": "Fires on a `pointerdown` whose coordinates land outside the dialog's\nbounding rect — i.e. on the browser-painted `::backdrop`. Call\n`event.preventDefault()` to veto closing and keep the modal open."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Dialog width; `data-density` scales the padding within each size."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-state",
            "value": "open",
            "when": "open"
          },
          {
            "name": "data-state",
            "value": "closed",
            "when": "closed"
          }
        ],
        "class": "primitiv-modal"
      },
      {
        "name": "Modal.Header",
        "extends": "HTMLDivElement",
        "props": [],
        "styledOnly": true,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__header"
      },
      {
        "name": "Modal.Body",
        "extends": "HTMLDivElement",
        "props": [],
        "styledOnly": true,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__body"
      },
      {
        "name": "Modal.Footer",
        "extends": "HTMLDivElement",
        "props": [],
        "styledOnly": true,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__footer"
      },
      {
        "name": "Modal.Title",
        "extends": "HTMLHeadingElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render into the consumer's own heading element (e.g. an `<h3>` for a\nnested dialog) instead of the default `<h2>`; the generated id is still\nregistered for `aria-labelledby`."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__title"
      },
      {
        "name": "Modal.Description",
        "extends": "HTMLParagraphElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render into the consumer's own element instead of the default `<p>`; the\ngenerated id is still registered for `aria-describedby`."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__description"
      },
      {
        "name": "Modal.Close",
        "extends": "HTMLButtonElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render into the consumer's own element (e.g. an icon-only button)\ninstead of the default `<button>`, merging the close behaviour in. The\nconsumer's `onClick` runs first and can `event.preventDefault()` to veto."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-modal__close"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add modal",
    "rootClass": "primitiv-modal",
    "customProperties": [
      {
        "name": "--primitiv-modal-surface",
        "defaultsTo": "var(--primitiv-surface-default)"
      },
      {
        "name": "--primitiv-modal-fg",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-modal-shadow",
        "defaultsTo": "var(--primitiv-elevation-modal)"
      },
      {
        "name": "--primitiv-modal-scrim",
        "defaultsTo": "var(--primitiv-scrim)"
      },
      {
        "name": "--primitiv-modal-radius",
        "defaultsTo": "var(--primitiv-modal-md-radius)"
      },
      {
        "name": "--primitiv-modal-padding-inline",
        "defaultsTo": "var(--primitiv-modal-md-padding-inline)"
      },
      {
        "name": "--primitiv-modal-padding-block",
        "defaultsTo": "var(--primitiv-modal-md-padding-block)"
      },
      {
        "name": "--primitiv-modal-gap",
        "defaultsTo": "var(--primitiv-modal-md-gap)"
      },
      {
        "name": "--primitiv-modal-width",
        "defaultsTo": "32.5rem"
      },
      {
        "name": "--primitiv-modal-border-width",
        "defaultsTo": "var(--primitiv-border-width-1)"
      },
      {
        "name": "--primitiv-modal-border-color",
        "defaultsTo": "var(--primitiv-border-default)"
      },
      {
        "name": "--primitiv-modal-divider-color",
        "defaultsTo": "var(--primitiv-border-subtle)"
      },
      {
        "name": "--primitiv-modal-title-color",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-modal-title-font-family",
        "defaultsTo": "var(--primitiv-label-md-font-family)"
      },
      {
        "name": "--primitiv-modal-title-font-size",
        "defaultsTo": "var(--primitiv-label-md-font-size)"
      },
      {
        "name": "--primitiv-modal-title-font-weight",
        "defaultsTo": "var(--primitiv-label-md-font-weight)"
      },
      {
        "name": "--primitiv-modal-title-line-height",
        "defaultsTo": "var(--primitiv-label-md-line-height)"
      },
      {
        "name": "--primitiv-modal-description-color",
        "defaultsTo": "var(--primitiv-content-secondary)"
      },
      {
        "name": "--primitiv-modal-description-font-family",
        "defaultsTo": "var(--primitiv-body-sm-font-family)"
      },
      {
        "name": "--primitiv-modal-description-font-size",
        "defaultsTo": "var(--primitiv-body-sm-font-size)"
      },
      {
        "name": "--primitiv-modal-description-font-weight",
        "defaultsTo": "var(--primitiv-body-sm-font-weight)"
      },
      {
        "name": "--primitiv-modal-description-line-height",
        "defaultsTo": "var(--primitiv-body-sm-line-height)"
      }
    ],
    "dataAttributes": [
      {
        "name": "data-state",
        "value": "open",
        "when": "open"
      },
      {
        "name": "data-state",
        "value": "closed",
        "when": "closed"
      },
      {
        "name": "data-state",
        "value": "open",
        "when": "open"
      },
      {
        "name": "data-state",
        "value": "closed",
        "when": "closed"
      }
    ]
  },
  "figma": {
