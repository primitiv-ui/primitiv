{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "textarea",
  "version": "0.1.0",
  "description": "A multi-line text input — the framed field consumers type longer content into.",
  "docs": "https://primitiv-ui.dev/docs/components/textarea",
  "root": {
    "element": "textarea",
    "class": "primitiv-textarea"
  },
  "dataAttributes": [
    { "name": "data-disabled", "value": "", "when": "disabled", "source": "auto" }
  ],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Control size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-textarea--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-textarea--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-textarea--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-textarea--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-textarea--xl", "description": "Extra large." }
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-textarea-bg", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-textarea-fg", "defaultsTo": "var(--primitiv-content-primary)" },
    { "name": "--primitiv-textarea-placeholder-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-textarea-border-color", "defaultsTo": "var(--primitiv-border-default)" },
    { "name": "--primitiv-textarea-border-color-focus", "defaultsTo": "var(--primitiv-border-focus)" },
    { "name": "--primitiv-textarea-border-color-invalid", "defaultsTo": "var(--primitiv-border-invalid)" },
    { "name": "--primitiv-textarea-border-width", "defaultsTo": "var(--primitiv-framed-control-border-width)" },
    { "name": "--primitiv-textarea-radius", "defaultsTo": "var(--primitiv-framed-control-md-radius)" },
    { "name": "--primitiv-textarea-min-height", "defaultsTo": "var(--primitiv-textarea-md-min-height)" },
    { "name": "--primitiv-textarea-padding-inline", "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)" },
    { "name": "--primitiv-textarea-padding-block", "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)" },
    { "name": "--primitiv-textarea-font-family", "defaultsTo": "var(--primitiv-body-md-font-family)" },
    { "name": "--primitiv-textarea-font-size", "defaultsTo": "var(--primitiv-body-md-font-size)" },
    { "name": "--primitiv-textarea-font-weight", "defaultsTo": "var(--primitiv-body-md-font-weight)" },
    { "name": "--primitiv-textarea-line-height", "defaultsTo": "var(--primitiv-body-md-line-height)" }
  ]
}
