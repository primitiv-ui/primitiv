{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "toggle-group",
  "version": "0.1.0",
  "description": "A set of independent on/off buttons in a shared track — any number can be pressed, including none. Framed like a Button: a pressed item is action/primary, an unpressed one action/secondary, inside a transparent bordered track whose radius is concentric with the items.",
  "docs": "https://primitiv-ui.dev/docs/components/toggle-group",
  "root": {
    "element": "div",
    "class": "primitiv-toggle-group",
    "component": "Root"
  },
  "dataAttributes": [
    {
      "name": "data-orientation",
      "value": "horizontal",
      "when": "horizontal",
      "source": "auto"
    },
    {
      "name": "data-orientation",
      "value": "vertical",
      "when": "vertical",
      "source": "auto"
    }
  ],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Control size for the whole widget; `data-density` scales each size further.",
      "options": [
        {
          "name": "xs",
          "class": "primitiv-toggle-group--xs",
          "description": "Extra small."
        },
        {
          "name": "sm",
          "class": "primitiv-toggle-group--sm",
          "description": "Small."
        },
        {
          "name": "md",
          "class": "primitiv-toggle-group--md",
          "description": "Medium (the default)."
        },
        {
          "name": "lg",
          "class": "primitiv-toggle-group--lg",
          "description": "Large."
        },
        {
          "name": "xl",
          "class": "primitiv-toggle-group--xl",
          "description": "Extra large."
        }
      ]
    },
    {
      "name": "justify",
      "default": "content",
      "description": "Whether items size to their content or share the track width equally.",
      "options": [
        {
          "name": "content",
          "class": "",
          "description": "Items size to their content — e.g. a B / I / U formatting toolbar (the default)."
        },
        {
          "name": "justified",
          "class": "primitiv-toggle-group--justified",
          "description": "Items share the track width equally — a true segmented control (e.g. Day / Week / Month)."
        }
      ]
    }
  ],
  "subcomponents": [
    {
      "name": "item",
      "component": "Item",
      "element": "button",
      "class": "primitiv-toggle-group__item",
      "wrapTextChildren": true,
      "dataAttributes": [
        {
          "name": "data-state",
          "value": "on",
          "when": "pressed",
          "source": "auto"
        },
        {
          "name": "data-state",
          "value": "off",
          "when": "not pressed",
          "source": "auto"
        },
        {
          "name": "data-disabled",
          "value": "",
          "when": "disabled",
          "source": "auto"
        }
      ]
    }
  ],
  "customProperties": [
    {
      "name": "--primitiv-toggle-group-item-height",
      "defaultsTo": "var(--primitiv-framed-control-md-height)"
    },
    {
      "name": "--primitiv-toggle-group-item-padding-inline",
      "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)"
    },
    {
      "name": "--primitiv-toggle-group-item-gap",
      "defaultsTo": "var(--primitiv-framed-control-md-gap)"
    },
    {
      "name": "--primitiv-toggle-group-item-icon-size",
      "defaultsTo": "var(--primitiv-framed-control-md-icon-size)"
    },
    {
      "name": "--primitiv-toggle-group-item-border-width",
      "defaultsTo": "var(--primitiv-framed-control-border-width)"
    },
    {
      "name": "--primitiv-toggle-group-track-inset",
      "defaultsTo": "var(--primitiv-toggle-group-track-padding)"
    },
    {
      "name": "--primitiv-toggle-group-item-radius",
      "defaultsTo": "var(--primitiv-framed-control-md-radius)"
    },
    {
      "name": "--primitiv-toggle-group-radius",
      "defaultsTo": "calc( var(--primitiv-toggle-group-item-radius) + var(--primitiv-toggle-group-track-inset) )"
    },
    {
      "name": "--primitiv-toggle-group-track-bg",
      "defaultsTo": "var(--primitiv-color-transparent)"
    },
    {
      "name": "--primitiv-toggle-group-track-border-color",
      "defaultsTo": "var(--primitiv-border-subtle)"
    },
    {
      "name": "--primitiv-toggle-group-track-border-width",
      "defaultsTo": "var(--primitiv-framed-control-border-width)"
    },
    {
      "name": "--primitiv-toggle-group-item-bg",
      "defaultsTo": "var(--primitiv-action-secondary-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-fg",
      "defaultsTo": "var(--primitiv-action-secondary-foreground-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-border-color",
      "defaultsTo": "var(--primitiv-action-secondary-border-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-bg-on",
      "defaultsTo": "var(--primitiv-action-primary-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-fg-on",
      "defaultsTo": "var(--primitiv-action-primary-foreground-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-border-color-on",
      "defaultsTo": "var(--primitiv-action-primary-border-default)"
    },
    {
      "name": "--primitiv-toggle-group-item-font-family",
      "defaultsTo": "var(--primitiv-label-md-font-family)"
    },
    {
      "name": "--primitiv-toggle-group-item-font-size",
      "defaultsTo": "var(--primitiv-label-md-font-size)"
    },
    {
      "name": "--primitiv-toggle-group-item-font-weight",
      "defaultsTo": "var(--primitiv-label-md-font-weight)"
    },
    {
      "name": "--primitiv-toggle-group-item-line-height",
      "defaultsTo": "var(--primitiv-label-md-line-height)"
    }
  ]
}
