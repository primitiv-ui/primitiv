{
  "name": "primitiv-ui",
  "version": "0.2.8",
  "description": "Primitiv UI — the design system CLI. Adds React components to a Vite or Next.js project, or Primitiv Elements (custom elements) to any HTML or server-rendered project: Spring, Maven, Gradle, Rails, Django.",
  "keywords": [
    "primitiv",
    "design-system",
    "cli",
    "react",
    "tailwind",
    "web-components",
    "custom-elements",
    "html",
    "maven",
    "gradle",
    "spring"
  ],
  "bin": {
    "primitiv": "./bin/primitiv.mjs"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@primitiv-ui/cli-darwin-arm64": "0.2.8",
    "@primitiv-ui/cli-darwin-x64": "0.2.8",
    "@primitiv-ui/cli-linux-x64-gnu": "0.2.8",
    "@primitiv-ui/cli-linux-arm64-gnu": "0.2.8",
    "@primitiv-ui/cli-win32-x64": "0.2.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/primitiv-ui/primitiv.git",
    "directory": "npm/cli-wrapper"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
