{
  // No "DOM" in lib, deliberately: core is the framework- and DOM-free half of
  // every component (RFC 0033 §3.1). A DOM type creeping into a signature is a
  // compile error here, not a review comment.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "types": ["vitest/globals"]
  },
  "include": ["src", "vitest.config.ts"]
}
