{
  "name": "@primitiv-ui/web",
  "version": "0.1.40",
  "private": true,
  "description": "Primitiv's headless components as standard custom elements: light DOM, no framework, no runtime dependencies. Works in plain HTML, server-rendered stacks, React, Vue, Angular and anything else that renders HTML.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tabs": {
      "types": "./src/tabs/index.ts",
      "default": "./src/tabs/index.ts"
    },
    "./define": {
      "types": "./src/define/index.ts",
      "default": "./src/define/index.ts"
    },
    "./define/tabs": {
      "types": "./src/define/tabs.ts",
      "default": "./src/define/tabs.ts"
    }
  },
  "sideEffects": [
    "./src/define/**",
    "./dist/define/**"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/primitiv-ui/primitiv.git",
    "directory": "packages/web"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/finalize-dist.mjs dist",
    "prepack": "pnpm run build",
    "qa": "pnpm qa:units",
    "qa:units": "vitest run --coverage",
    "qa:units:watch": "vitest --coverage",
    "mutate": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@primitiv-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@primitiv-ui/conformance": "workspace:*",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tabs": {
        "types": "./dist/tabs/index.d.ts",
        "default": "./dist/tabs/index.js"
      },
      "./define": {
        "types": "./dist/define/index.d.ts",
        "default": "./dist/define/index.js"
      },
      "./define/tabs": {
        "types": "./dist/define/tabs.d.ts",
        "default": "./dist/define/tabs.js"
      }
    }
  }
}
