{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "alert",
  "version": "0.1.0",
  "description": "An assertive banner for high-priority, time-sensitive messages — a tone-matched icon, an optional title, a description, and an optional dismiss button. Composes the headless Alert primitive (role=\"alert\"). Sized xs–xl; `data-density` scales each size further.",
  "docs": "https://primitiv-ui.dev/docs/components/alert",
  "root": {
    "element": "div",
    "class": "primitiv-alert"
  },
  "dataAttributes": [],
  "modifiers": [
    {
      "name": "tone",
      "default": "info",
      "description": "Semantic colour; also selects the leading icon.",
      "options": [
        { "name": "info", "class": "primitiv-alert--info", "description": "Info (the default)." },
        { "name": "success", "class": "primitiv-alert--success", "description": "Success." },
        { "name": "warning", "class": "primitiv-alert--warning", "description": "Warning." },
        { "name": "danger", "class": "primitiv-alert--danger", "description": "Danger." }
      ]
    },
    {
      "name": "size",
      "default": "md",
      "description": "Alert size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-alert--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-alert--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-alert--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-alert--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-alert--xl", "description": "Extra large." }
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-alert-background", "defaultsTo": "var(--primitiv-feedback-info-soft-background)" },
    { "name": "--primitiv-alert-foreground", "defaultsTo": "var(--primitiv-feedback-info-soft-foreground)" },
    { "name": "--primitiv-alert-padding-inline", "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)" },
    { "name": "--primitiv-alert-padding-block", "defaultsTo": "var(--primitiv-alert-md-padding-block)" },
    { "name": "--primitiv-alert-gap", "defaultsTo": "var(--primitiv-framed-control-md-gap)" },
    { "name": "--primitiv-alert-icon-size", "defaultsTo": "var(--primitiv-framed-control-md-icon-size)" },
    { "name": "--primitiv-alert-radius", "defaultsTo": "var(--primitiv-framed-control-md-radius)" },
    { "name": "--primitiv-alert-title-font-family", "defaultsTo": "var(--primitiv-label-md-font-family)" },
    { "name": "--primitiv-alert-title-font-size", "defaultsTo": "var(--primitiv-label-md-font-size)" },
    { "name": "--primitiv-alert-title-font-weight", "defaultsTo": "var(--primitiv-label-md-font-weight)" },
    { "name": "--primitiv-alert-title-line-height", "defaultsTo": "var(--primitiv-label-md-line-height)" },
    { "name": "--primitiv-alert-description-font-family", "defaultsTo": "var(--primitiv-body-md-font-family)" },
    { "name": "--primitiv-alert-description-font-size", "defaultsTo": "var(--primitiv-body-md-font-size)" },
    { "name": "--primitiv-alert-description-font-weight", "defaultsTo": "var(--primitiv-body-md-font-weight)" },
    { "name": "--primitiv-alert-description-line-height", "defaultsTo": "var(--primitiv-body-md-line-height)" }
  ]
}
