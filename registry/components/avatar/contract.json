{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "avatar",
  "version": "0.1.0",
  "description": "A user image with a graceful fallback for while it loads, or when it is missing or broken.",
  "docs": "https://primitiv-ui.dev/docs/components/avatar",
  "root": {
    "element": "span",
    "class": "primitiv-avatar",
    "component": "Root"
  },
  "dataAttributes": [
    { "name": "data-status", "value": "idle", "when": "idle", "source": "auto" },
    { "name": "data-status", "value": "loading", "when": "loading", "source": "auto" },
    { "name": "data-status", "value": "loaded", "when": "loaded", "source": "auto" },
    { "name": "data-status", "value": "error", "when": "error", "source": "auto" }
  ],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Control size; `data-density` scales each size further.",
      "options": [
        { "name": "xs", "class": "primitiv-avatar--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-avatar--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-avatar--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-avatar--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-avatar--xl", "description": "Extra large." }
      ]
    },
    {
      "name": "shape",
      "default": "circle",
      "description": "Corner treatment — fully rounded, or square with size-scaled corners.",
      "options": [
        { "name": "circle", "class": "primitiv-avatar--circle", "description": "Fully rounded (the default)." },
        { "name": "square", "class": "primitiv-avatar--square", "description": "Square with corners scaled to size." }
      ]
    }
  ],
  "subcomponents": [
    {
      "name": "image",
      "component": "Image",
      "class": "primitiv-avatar__image",
      "dataAttributes": [
        { "name": "data-status", "value": "idle", "when": "idle", "source": "auto" },
        { "name": "data-status", "value": "loading", "when": "loading", "source": "auto" },
        { "name": "data-status", "value": "loaded", "when": "loaded", "source": "auto" },
        { "name": "data-status", "value": "error", "when": "error", "source": "auto" }
      ]
    },
    {
      "name": "fallback",
      "component": "Fallback",
      "class": "primitiv-avatar__fallback",
      "wrapTextChildren": true,
      "dataAttributes": [
        { "name": "data-status", "value": "idle", "when": "idle", "source": "auto" },
        { "name": "data-status", "value": "loading", "when": "loading", "source": "auto" },
        { "name": "data-status", "value": "loaded", "when": "loaded", "source": "auto" },
        { "name": "data-status", "value": "error", "when": "error", "source": "auto" }
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-avatar-size", "defaultsTo": "var(--primitiv-framed-control-md-height)" },
    { "name": "--primitiv-avatar-icon-size", "defaultsTo": "var(--primitiv-framed-control-md-icon-size)" },
    { "name": "--primitiv-avatar-radius", "defaultsTo": "var(--primitiv-avatar-radius-full)" },
    { "name": "--primitiv-avatar-square-radius", "defaultsTo": "var(--primitiv-avatar-radius-md)" },
    { "name": "--primitiv-avatar-border-width", "defaultsTo": "var(--primitiv-framed-control-border-width)" },
    { "name": "--primitiv-avatar-border-color", "defaultsTo": "var(--primitiv-border-default)" },
    { "name": "--primitiv-avatar-fallback-bg", "defaultsTo": "var(--primitiv-action-secondary-default)" },
    { "name": "--primitiv-avatar-fallback-fg", "defaultsTo": "var(--primitiv-action-secondary-foreground-default)" },
    { "name": "--primitiv-avatar-fallback-font-family", "defaultsTo": "var(--primitiv-label-md-font-family)" },
    { "name": "--primitiv-avatar-fallback-font-size", "defaultsTo": "var(--primitiv-label-md-font-size)" },
    { "name": "--primitiv-avatar-fallback-font-weight", "defaultsTo": "var(--primitiv-label-md-font-weight)" }
  ]
}
