{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "data-table",
  "version": "0.1.0",
  "description": "A framed data-table shell — a toolbar, a table and a footer that read as one object, plus the anatomy sorting, selection and expandable rows need. Owns no state: sorting, selection, expansion, filtering and pagination all arrive as props, so an external table engine (TanStack Table) can drive it.",
  "docs": "https://primitiv-ui.dev/docs/components/data-table",
  "root": {
    "element": "div",
    "class": "primitiv-data-table",
    "component": "DataTable"
  },
  "dataAttributes": [],
  "modifiers": [
    {
      "name": "size",
      "default": "md",
      "description": "Type scale for the table and its bars; `data-density` scales padding further.",
      "options": [
        { "name": "xs", "class": "primitiv-data-table--xs", "description": "Extra small." },
        { "name": "sm", "class": "primitiv-data-table--sm", "description": "Small." },
        { "name": "md", "class": "primitiv-data-table--md", "description": "Medium (the default)." },
        { "name": "lg", "class": "primitiv-data-table--lg", "description": "Large." },
        { "name": "xl", "class": "primitiv-data-table--xl", "description": "Extra large." }
      ]
    },
    {
      "name": "frame",
      "default": "framed",
      "description": "Whether the shell draws its own surface, hairline and radius.",
      "options": [
        { "name": "framed", "class": "", "description": "A bordered, radiused panel (the default) — the toolbar, table and footer read as one object." },
        { "name": "bare", "class": "primitiv-data-table--bare", "description": "No surface, border or radius, and the bars lose their inline padding — for a table already inside a Card or panel, so a second border is never drawn." }
      ]
    },
    {
      "name": "sticky",
      "default": "false",
      "description": "Pins the header row while the body scrolls. Adds an opaque header background, which the base Table deliberately does not have.",
      "options": [
        { "name": "false", "class": "", "description": "Header scrolls with the body (the default)." },
        { "name": "true", "class": "primitiv-data-table--sticky", "description": "Header sticks to the top of the scroll area." }
      ]
    }
  ],
  "subcomponents": [
    { "name": "toolbar", "component": "DataTableToolbar", "element": "div", "class": "primitiv-data-table__toolbar", "dataAttributes": [] },
    { "name": "footer", "component": "DataTableFooter", "element": "div", "class": "primitiv-data-table__footer", "dataAttributes": [] },
    { "name": "region", "component": "DataTableRegion", "element": "div", "class": "primitiv-data-table__region", "dataAttributes": [] },
    { "name": "control-cell", "component": "DataTableControlCell", "element": "td", "class": "primitiv-data-table__control-cell", "dataAttributes": [] },
    { "name": "sort-button", "component": "DataTableSortButton", "element": "button", "class": "primitiv-data-table__sort", "dataAttributes": [] },
    { "name": "expand-trigger", "component": "DataTableExpandTrigger", "element": "button", "class": "primitiv-data-table__expand", "dataAttributes": [
      { "name": "data-state", "value": "open | closed", "when": "the row's detail panel is revealed or hidden", "source": "headless Table.ExpandTrigger" }
    ] },
    { "name": "detail-row", "component": "DataTableDetailRow", "element": "tr", "class": "primitiv-data-table__detail-row", "dataAttributes": [
      { "name": "data-state", "value": "open | closed", "when": "the panel is revealed or hidden", "source": "headless Table.DetailRow" }
    ] }
  ],
  "customProperties": [
    { "name": "--primitiv-data-table-background", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-data-table-border-color", "defaultsTo": "var(--primitiv-border-default)" },
    { "name": "--primitiv-data-table-border-width", "defaultsTo": "var(--primitiv-border-width-1)" },
    { "name": "--primitiv-data-table-radius", "defaultsTo": "var(--primitiv-surface-md-radius)" },
    { "name": "--primitiv-data-table-rule-color", "defaultsTo": "var(--primitiv-border-subtle)" },
    { "name": "--primitiv-data-table-header-background", "defaultsTo": "var(--primitiv-surface-default)" },
    { "name": "--primitiv-data-table-bar-padding-inline", "defaultsTo": "var(--primitiv-table-cell-padding-inline)" },
    { "name": "--primitiv-data-table-bar-padding-block", "defaultsTo": "var(--primitiv-table-cell-padding-block)" },
    { "name": "--primitiv-data-table-bar-gap", "defaultsTo": "var(--primitiv-table-cell-padding-block)" },
    { "name": "--primitiv-data-table-control-padding-inline", "defaultsTo": "var(--primitiv-table-cell-padding-block)" },
    { "name": "--primitiv-data-table-sort-gap", "defaultsTo": "var(--primitiv-space-space-4)" },
    { "name": "--primitiv-data-table-sort-hover-background", "defaultsTo": "var(--primitiv-table-row-hover)" },
    { "name": "--primitiv-data-table-sort-idle-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-data-table-expand-color", "defaultsTo": "var(--primitiv-content-muted)" },
    { "name": "--primitiv-data-table-expand-hover-background", "defaultsTo": "var(--primitiv-action-ghost-hover)" },
    { "name": "--primitiv-data-table-detail-indent", "defaultsTo": "0px" },
    { "name": "--primitiv-data-table-detail-padding-inline", "defaultsTo": "var(--primitiv-table-cell-padding-inline)" },
    { "name": "--primitiv-data-table-detail-padding-block", "defaultsTo": "var(--primitiv-table-cell-padding-block)" },
    { "name": "--primitiv-data-table-transition-duration", "defaultsTo": "var(--primitiv-motion-duration-expand)" },
    { "name": "--primitiv-data-table-transition-easing", "defaultsTo": "var(--primitiv-motion-easing-default)" },
    { "name": "--primitiv-data-table-focus-ring-color", "defaultsTo": "var(--primitiv-border-focus)" },
    { "name": "--primitiv-data-table-focus-ring-width", "defaultsTo": "var(--primitiv-border-width-2)" }
  ]
}
