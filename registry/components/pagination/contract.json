{
  "$schema": "https://primitiv-ui.dev/schema/contract.json",
  "name": "pagination",
  "version": "0.1.0",
  "description": "Page navigation for a paged collection — a row of square page cells with prev/next chevrons, or a compact \"Page X of Y\" readout. Truncated ranges collapse behind an ellipsis that opens a menu of the hidden pages.",
  "docs": "https://primitiv-ui.dev/docs/components/pagination",
  "root": {
    "element": "nav",
    "class": "primitiv-pagination",
    "component": "Pagination"
  },
  "subcomponents": [],
  "modifiers": [
    {
      "name": "size",
      "classes": [
        "primitiv-pagination--xs",
        "primitiv-pagination--sm",
        "primitiv-pagination--md",
        "primitiv-pagination--lg",
        "primitiv-pagination--xl"
      ]
    },
    {
      "name": "variant",
      "classes": [
        "primitiv-pagination--numbered",
        "primitiv-pagination--compact"
      ]
    }
  ],
  "customProperties": [
    { "name": "--primitiv-pagination-gap", "defaultsTo": "var(--primitiv-pagination-md-gap)" },
    { "name": "--primitiv-pagination-item-min-inline-size", "defaultsTo": "var(--primitiv-pagination-md-item-min-width)" },
    { "name": "--primitiv-pagination-group-gap", "defaultsTo": "var(--primitiv-space-space-24)" },
    { "name": "--primitiv-pagination-menu-min-inline-size", "defaultsTo": "var(--primitiv-pagination-md-item-min-width)" }
  ]
}
