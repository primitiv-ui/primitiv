{
  "id": "avatar",
  "displayName": "Avatar",
  "kind": "registry",
  "status": "stable",
  "category": "Data Display",
  "description": "A user image with a graceful fallback for while it loads, or when it is missing or broken.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Avatar.Root",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's own element instead of the native `<span>`, merging\nthe `data-status` hook onto it via {@link Slot }."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control size; `data-density` scales each size further."
          },
          {
            "name": "shape",
            "type": "\"circle\" | \"square\"",
            "default": "circle",
            "description": "Corner treatment — fully rounded, or square with size-scaled corners."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-status",
            "value": "idle",
            "when": "idle"
          },
          {
            "name": "data-status",
            "value": "loading",
            "when": "loading"
          },
          {
            "name": "data-status",
            "value": "loaded",
            "when": "loaded"
          },
          {
            "name": "data-status",
            "value": "error",
            "when": "error"
          }
        ],
        "class": "primitiv-avatar"
      },
      {
        "name": "Avatar.Image",
        "extends": "HTMLImageElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's own `<img>` instead of the native one, merging the\nload handlers, ref, and `data-status` hook onto it via {@link Slot }."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [
          {
            "name": "data-status",
            "value": "idle",
            "when": "idle"
          },
          {
            "name": "data-status",
            "value": "loading",
            "when": "loading"
          },
          {
            "name": "data-status",
            "value": "loaded",
            "when": "loaded"
          },
          {
            "name": "data-status",
            "value": "error",
            "when": "error"
          }
        ],
        "class": "primitiv-avatar__image"
      },
      {
        "name": "Avatar.Fallback",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's own element instead of the native `<span>`, merging\nthe `data-status` hook onto it via {@link Slot }."
          },
          {
            "name": "delayMs",
            "type": "number",
            "required": false,
            "default": null,
            "description": "Withhold the fallback for this many milliseconds after mount. Useful to\navoid a flash of fallback content on fast connections where the image\nloads almost immediately. Omit to render the fallback straight away."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [
          {
            "name": "data-status",
            "value": "idle",
            "when": "idle"
          },
          {
            "name": "data-status",
            "value": "loading",
            "when": "loading"
          },
          {
            "name": "data-status",
            "value": "loaded",
            "when": "loaded"
          },
          {
            "name": "data-status",
            "value": "error",
            "when": "error"
          }
        ],
        "class": "primitiv-avatar__fallback"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add avatar",
    "rootClass": "primitiv-avatar",
    "customProperties": [
      {
        "name": "--primitiv-avatar-size",
