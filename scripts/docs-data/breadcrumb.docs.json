{
  "id": "breadcrumb",
  "displayName": "Breadcrumb",
  "kind": "registry",
  "status": "stable",
  "category": "Disclosure",
  "description": "A WAI-ARIA breadcrumb trail — a nav landmark wrapping an ordered list of ancestor-page links, ending with the current page.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Breadcrumb.Root",
        "extends": "HTMLElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control size; `data-density` scales each size further."
          }
        ],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb"
      },
      {
        "name": "Breadcrumb.List",
        "extends": "HTMLOListElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb__list"
      },
      {
        "name": "Breadcrumb.Item",
        "extends": "HTMLLIElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb__item"
      },
      {
        "name": "Breadcrumb.Link",
        "extends": "HTMLAnchorElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Renders the child element instead of a native `<a>`, merging all of\n`Breadcrumb.Link`'s props — `href`, event handlers, `className`,\n`ref` — onto it via {@link Slot }. Use for routing-library link\ncomponents (e.g. React Router's `<Link>`) that need breadcrumb\nsemantics. See the `asChild` example on {@link BreadcrumbLink }."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb__link"
      },
      {
        "name": "Breadcrumb.Page",
        "extends": "HTMLSpanElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [
          {
            "name": "aria-current",
            "value": "page",
            "when": "always"
          }
        ],
        "class": "primitiv-breadcrumb__page"
      },
      {
        "name": "Breadcrumb.Separator",
        "extends": "HTMLLIElement",
        "props": [],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb__separator"
      },
      {
        "name": "Breadcrumb.Ellipsis",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Renders the child element instead of a native `<span>`, merging all of\n`Breadcrumb.Ellipsis`'s props — `role`, `aria-hidden`, `className`,\n`ref` — onto it via {@link Slot }. See the `asChild` example on\n{@link BreadcrumbEllipsis }."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-breadcrumb__ellipsis"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add breadcrumb",
    "rootClass": "primitiv-breadcrumb",
    "customProperties": [
      {
        "name": "--primitiv-breadcrumb-gap",
        "defaultsTo": "var(--primitiv-space-space-4)"
      },
      {
        "name": "--primitiv-breadcrumb-icon-size",
        "defaultsTo": "var(--primitiv-breadcrumb-md-icon-size)"
      },
      {
        "name": "--primitiv-breadcrumb-font-family",
        "defaultsTo": "var(--primitiv-body-md-font-family)"
      },
      {
        "name": "--primitiv-breadcrumb-font-size",
        "defaultsTo": "var(--primitiv-body-md-font-size)"
      },
      {
        "name": "--primitiv-breadcrumb-font-weight",
        "defaultsTo": "var(--primitiv-body-md-font-weight)"
      },
      {
        "name": "--primitiv-breadcrumb-line-height",
        "defaultsTo": "var(--primitiv-body-md-line-height)"
      },
      {
        "name": "--primitiv-breadcrumb-link-color",
        "defaultsTo": "var(--primitiv-content-muted)"
      },
      {
        "name": "--primitiv-breadcrumb-link-color-hover",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-breadcrumb-page-color",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-breadcrumb-separator-color",
        "defaultsTo": "var(--primitiv-content-muted)"
      }
    ],
    "dataAttributes": [
      {
        "name": "aria-current",
        "value": "page",
        "when": "always"
      }
    ]
  },
  "figma": {
    "componentSetKey": "436:12911"
  }
}
