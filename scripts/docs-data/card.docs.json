        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Render the single child element instead of a wrapping `<h3>`, merging\nthe title classes onto it — use this to set the correct heading level\nfor the surrounding document outline."
          }
        ],
        "styledOnly": false,
