{
  "id": "card",
  "displayName": "Card",
  "kind": "registry-only",
  "status": "stable",
  "category": "Data Display",
  "description": "A content container — an optional media region plus a padded content block holding a header, description and footer. `layout` picks the arrangement: `vertical` (media above), `horizontal` (media beside), or `cover` (media behind the content, under a legibility scrim). Sized xs–xl; `data-density` scales each size further.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@/components/ui/card",
    "subComponents": [
      {
        "name": "Card",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Render the single child element instead of a wrapping `<div>`, merging\nthe card classes onto it — e.g. `<Card asChild><a href=\"...\">...</a></Card>`\nfor a card that is itself one link."
          },
          {
            "name": "coverForegroundDark",
            "type": "\"white\" | \"black\"",
            "required": false,
            "default": "\"white\"",
            "description": "The title/description colour while the app is in **dark** theme. Only\nhas an effect when `layout=\"cover\"`. See {@link coverForegroundLight }."
          },
          {
            "name": "coverForegroundLight",
            "type": "\"white\" | \"black\"",
            "required": false,
            "default": "\"white\"",
            "description": "The title/description colour while the app is in **light** theme.\nOnly has an effect when `layout=\"cover\"`. Limited to the two absolute\n(non-theme-flipping) tones — the scrim itself is always\n`color/absolute-black` regardless of theme, so `\"white\"` is legible\nagainst it in every case except an unusually bright photo. Set this\nindependently of `coverForegroundDark`: a given photo's legibility\ndoesn't necessarily track the app's own light/dark switch."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "layout",
            "type": "\"vertical\" | \"horizontal\" | \"cover\"",
            "default": "vertical",
            "description": "How the media region relates to the content."
          },
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Card size; `data-density` scales each size further."
          },
          {
            "name": "elevation",
            "type": "\"flat\" | \"raised\"",
            "default": "flat",
            "description": "Resting shadow depth."
          },
          {
            "name": "scrim",
            "type": "\"soft\" | \"medium\" | \"strong\"",
            "default": "medium",
            "description": "Strength of the legibility gradient. Only rendered by `layout=\"cover\"`."
          }
        ],
        "dataAttributes": [],
        "class": "primitiv-card"
      },
      {
        "name": "CardMedia",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The image, `<picture>`, `<video>` or `<svg>` to show. It is sized to\ncover the region, so it needs no sizing of its own."
          },
          {
            "name": "inset",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Inset the media from the card edge and round its corners, instead of\nbleeding it flush to the border.\n\nFlush media is deliberately square-cornered — the card's own\n`overflow: hidden` supplies the outer radius, so giving the media its\nown would also round the inner seam where it meets the content and\nleave a visible notch."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": null
      },
      {
