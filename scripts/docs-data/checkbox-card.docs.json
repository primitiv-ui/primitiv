{
  "id": "checkbox-card",
  "displayName": "CheckboxCard",
  "kind": "registry",
  "status": "stable",
  "category": "Forms",
  "description": "A card/tile-shaped checkbox — the whole bordered surface is the interactive element, not a small control plus a separate label. Composes the headless CheckboxCard primitive (role=\"checkbox\", tri-state unchecked/checked/indeterminate). Sized xs–xl; `data-density` scales each size further.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "CheckboxCard.Root",
        "extends": "HTMLButtonElement",
        "props": [
          {
            "name": "title",
            "type": "string & ReactElement<unknown, string | JSXElementConstructor<any>> | string & Iterable<ReactNode> | string & ReactPortal | string & Promise<AwaitedReactNode> | undefined",
            "required": true,
            "default": null,
            "description": "The card's heading. Always present — the required content."
          },
          {
            "name": "checked",
            "type": "CheckedState",
            "required": false,
            "default": null,
            "description": "Forbidden in uncontrolled mode — use `defaultChecked` instead.\nThe controlled tri-state checked value (`true` / `false` /\n`\"indeterminate\"`). Must be kept in sync by the parent via\n`onCheckedChange`."
          },
          {
            "name": "defaultChecked",
            "type": "CheckedState",
            "required": false,
            "default": "false",
            "description": "Tri-state checked value on first render (`true` / `false` /\n`\"indeterminate\"`). Defaults to `false` when omitted.\nForbidden in controlled mode — use `checked` instead."
          },
          {
            "name": "description",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The card's supporting text, shown below the title."
          },
          {
            "name": "onCheckedChange",
            "type": "(checked: boolean) => void",
            "required": false,
            "default": null,
            "description": "Called with the new **boolean** checked state whenever the card toggles.\nAn indeterminate card resolves to `true` on first click. Optional in\nuncontrolled mode.\nCalled with the new **boolean** checked state when the user toggles. An\nindeterminate card resolves to `true` on click. Required in controlled\nmode."
          },
          {
            "name": "ref",
            "type": "Ref<HTMLButtonElement>",
            "required": false,
            "default": null,
            "description": "Allows getting a ref to the component instance.\nOnce the component unmounts, React will set `ref.current` to `null`\n(or call the ref with `null` if you passed a callback ref).\nForwarded to the rendered element (the `<button>` by default)."
          },
          {
            "name": "showDescription",
            "type": "boolean",
            "required": false,
            "default": "true",
            "description": "Shows or hides `description` without unmounting the title — a\nseparate, skippable subcomponent, not a change to the anatomy."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Card size; `data-density` scales each size further."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-state",
            "value": "checked",
            "when": "checked"
          },
          {
            "name": "data-state",
            "value": "unchecked",
            "when": "unchecked"
          },
          {
            "name": "data-state",
            "value": "indeterminate",
            "when": "indeterminate"
          },
          {
            "name": "data-disabled",
            "value": "",
            "when": "disabled"
          }
        ],
        "class": "primitiv-checkbox-card"
      },
      {
        "name": "CheckboxCard.Indicator",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "When `true`, render the consumer's own element (typically an `<svg>`) as\nthe indicator instead of the default `<span>`, merging `aria-hidden` and\n`data-state` onto it via the {@link Slot } pattern."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The indicator content — typically an `<svg>` tick or check glyph."
          },
          {
            "name": "forceMount",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Keep the indicator mounted while the card is **unchecked** so a CSS exit\nanimation can play against `data-state=\"unchecked\"`. By default the\nindicator unmounts as soon as the card is unchecked."
          }
        ],
        "styledOnly": false,
        "headlessOnly": true,
        "contractProps": [],
        "dataAttributes": [
          {
            "name": "data-state",
            "value": "checked",
            "when": "the card's checked state"
          },
          {
            "name": "data-state",
            "value": "unchecked",
            "when": "the card's checked state"
          },
          {
            "name": "data-state",
            "value": "indeterminate",
            "when": "the card's checked state"
          }
        ],
        "class": "primitiv-checkbox-card__mark"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add checkbox-card",
    "rootClass": "primitiv-checkbox-card",
    "customProperties": [
      {
        "name": "--primitiv-checkbox-card-bg",
