        "defaultsTo": "var(--primitiv-border-width-1)"
      },
      {
        "name": "--primitiv-checkbox-mark-color",
        "defaultsTo": "var(--primitiv-action-primary-foreground-default)"
      },
      {
        "name": "--primitiv-checkbox-size",
        "defaultsTo": "var(--primitiv-checkbox-md-box-size)"
      },
      {
