        "value": "checked",
        "when": "checked"
      },
      {
        "name": "data-state",
        "value": "unchecked",
        "when": "unchecked"
      },
      {
        "name": "data-state",
        "value": "indeterminate",
        "when": "indeterminate"
      },
      {
        "name": "data-disabled",
        "value": "",
        "when": "disabled"
      }
    ]
  },
