{
  "id": "chip",
  "displayName": "Chip",
  "kind": "registry-only",
  "status": "stable",
  "category": "Data Display",
  "description": "An interactive, removable label chip — filter bars, multi-select fields, inputs. The trailing remove button is core to the anatomy, not optional; an optional leading icon or avatar may precede the label. Sized xs–xl; `data-density` scales each size further.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@/components/ui/chip",
    "subComponents": [
      {
        "name": "Chip",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "children",
            "type": "ReactNode",
            "required": true,
            "default": null,
            "description": "The chip's label content."
          },
          {
            "name": "onRemove",
            "type": "() => void",
            "required": true,
            "default": null,
            "description": "Called when the remove button is activated. Required: removability is\ncore to a Chip's anatomy, not an optional affordance — use `Tag` for a\nnon-removable label."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Disables the remove button and dims the whole chip."
          },
          {
            "name": "leadingIcon",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "An optional icon or avatar rendered before the label — e.g.\n`<Chip leadingIcon={<User />}>Jane Doe</Chip>`."
          },
          {
            "name": "removeLabel",
            "type": "string",
            "required": false,
            "default": "`Remove ${children}` when `children` is a string, else `\"Remove\"`.",
            "description": "`aria-label` for the remove button."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Chip size; `data-density` scales each size further.",
            "classes": {
              "xs": "primitiv-chip--xs",
              "sm": "primitiv-chip--sm",
              "md": "primitiv-chip--md",
              "lg": "primitiv-chip--lg",
              "xl": "primitiv-chip--xl"
            }
          }
        ],
        "dataAttributes": [],
        "class": "primitiv-chip"
      }
    ]
  },
