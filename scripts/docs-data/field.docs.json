{
  "id": "field",
  "displayName": "Field",
  "kind": "registry",
  "status": "stable",
  "category": "Forms",
  "description": "A form-field wrapper — coordinates a label, control, description, and error message and cascades id / validity / disabled / required to the control it wraps.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Field.Root",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's element instead of `<div>` via the\n{@link Slot } pattern — e.g. a semantic `<fieldset>`. The\n`data-field-*` hooks and context provider are preserved."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The label, control, description, and error sub-components composed\ninside the field."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Disables the field. Cascades to the control's `disabled` prop and\nsets `data-field-disabled` on the wrapper."
          },
          {
            "name": "id",
            "type": "string",
            "required": false,
            "default": null,
            "description": "Stable id for the field. Wired to the control via\n{@link FieldLabel `Field.Label`}'s `htmlFor`, and used to derive\nthe `descriptionId` (`<id>-description`) and `errorId`\n(`<id>-error`) exposed through {@link FieldContext }. Auto-generated\nvia React's `useId` when omitted."
          },
          {
            "name": "invalid",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Marks the field invalid. Cascades to a context-aware control (e.g.\n`Input`) as `aria-invalid`, sets `data-field-invalid` on the\nwrapper, and gates {@link FieldErrorText `Field.ErrorText`}\nrendering."
          },
          {
            "name": "required",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Marks the field required. Cascades to the control's `required` prop\nand sets `data-field-required` on the wrapper."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control size for the whole field; `data-density` scales each size further."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-field",
            "value": "",
            "when": "always"
          },
          {
            "name": "data-field-invalid",
            "value": "",
            "when": "invalid"
          },
          {
            "name": "data-field-disabled",
            "value": "",
            "when": "disabled"
          },
          {
            "name": "data-field-required",
            "value": "",
            "when": "required"
          }
        ],
        "class": "primitiv-field"
      },
      {
        "name": "Field.Label",
        "extends": "HTMLLabelElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's element instead of `<label>` via the\n{@link Slot } pattern, with `htmlFor` merged on."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The label text."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-field__label"
      },
      {
        "name": "Field.Description",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's element instead of `<div>` via the\n{@link Slot } pattern (e.g. a `<p>` or `<span>`), with the derived\n`id` merged on."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The helper text."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-field__description"
      },
      {
        "name": "Field.ErrorText",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Render the consumer's element instead of `<div>` via the\n{@link Slot } pattern, with the derived `id` and `role=\"alert\"`\nmerged on."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "The error message."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [],
        "dataAttributes": [],
        "class": "primitiv-field__error"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add field",
    "rootClass": "primitiv-field",
    "customProperties": [
      {
        "name": "--primitiv-field-gap",
        "defaultsTo": "var(--primitiv-space-space-8)"
      },
      {
        "name": "--primitiv-field-label-color",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-field-label-font-family",
        "defaultsTo": "var(--primitiv-label-md-font-family)"
      },
      {
        "name": "--primitiv-field-label-font-size",
        "defaultsTo": "var(--primitiv-label-md-font-size)"
      },
      {
        "name": "--primitiv-field-label-font-weight",
        "defaultsTo": "var(--primitiv-label-md-font-weight)"
      },
      {
        "name": "--primitiv-field-label-line-height",
        "defaultsTo": "var(--primitiv-label-md-line-height)"
      },
      {
        "name": "--primitiv-field-helper-color",
        "defaultsTo": "var(--primitiv-content-muted)"
      },
      {
        "name": "--primitiv-field-error-color",
        "defaultsTo": "var(--primitiv-content-error)"
      },
      {
        "name": "--primitiv-field-helper-font-family",
        "defaultsTo": "var(--primitiv-body-sm-font-family)"
      },
      {
        "name": "--primitiv-field-helper-font-size",
        "defaultsTo": "var(--primitiv-body-sm-font-size)"
      },
      {
        "name": "--primitiv-field-helper-font-weight",
        "defaultsTo": "var(--primitiv-body-sm-font-weight)"
      },
      {
        "name": "--primitiv-field-helper-line-height",
        "defaultsTo": "var(--primitiv-body-sm-line-height)"
      },
      {
        "name": "--primitiv-field-required-color",
        "defaultsTo": "var(--primitiv-content-error)"
      },
      {
        "name": "--primitiv-field-required-gap",
        "defaultsTo": "var(--primitiv-space-space-2)"
      }
    ],
    "dataAttributes": [
      {
        "name": "data-field",
        "value": "",
        "when": "always"
      },
      {
        "name": "data-field-invalid",
        "value": "",
        "when": "invalid"
      },
      {
        "name": "data-field-disabled",
        "value": "",
        "when": "disabled"
      },
      {
        "name": "data-field-required",
        "value": "",
        "when": "required"
      }
    ]
  },
  "figma": {
    "componentSetKey": "394:7449"
  }
}
