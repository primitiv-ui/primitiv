{
  "id": "stack",
  "displayName": "Stack",
  "kind": "registry-only",
  "status": "stable",
  "category": "Layout",
  "description": "A Flexbox stack — `direction` picks the axis, `gap` the spacing (a density-scaled Context token per step), `wrap` whether the row may break onto additional lines, and `align`/`justify` the alignment, all as modifier classes. No inline styles: the alignment props are curated presets, not raw CSS keywords.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@/components/ui/stack",
    "subComponents": [
      {
        "name": "Stack",
        "extends": "HTMLDivElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Render the single child element instead of a wrapping <div>, merging\nthe stack classes onto it — e.g. `<Stack asChild><ul>...</ul></Stack>`."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "direction",
            "type": "\"column\" | \"row\" | \"column-reverse\" | \"row-reverse\"",
            "default": "column",
            "description": "Flex axis, and its resting or reversed order — the four `flex-direction` keywords directly.",
            "classes": {
              "column": "primitiv-stack--column",
              "row": "primitiv-stack--row",
              "column-reverse": "primitiv-stack--column-reverse",
              "row-reverse": "primitiv-stack--row-reverse"
            }
          },
          {
            "name": "gap",
            "type": "\"none\" | \"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Space between children; each step (except none) is a density-scaled Context token.",
            "classes": {
              "none": "primitiv-stack--gap-none",
              "xs": "primitiv-stack--gap-xs",
              "sm": "primitiv-stack--gap-sm",
              "md": "primitiv-stack--gap-md",
              "lg": "primitiv-stack--gap-lg",
              "xl": "primitiv-stack--gap-xl"
            }
          },
          {
            "name": "align",
            "type": "\"start\" | \"center\" | \"end\" | \"stretch\" | \"baseline\"",
            "default": "stretch",
            "description": "Cross-axis alignment (`align-items`), as a preset set rather than a raw CSS passthrough.",
            "classes": {
              "start": "primitiv-stack--align-start",
              "center": "primitiv-stack--align-center",
              "end": "primitiv-stack--align-end",
              "stretch": "primitiv-stack--align-stretch",
              "baseline": "primitiv-stack--align-baseline"
            }
          },
          {
            "name": "wrap",
            "type": "\"nowrap\" | \"wrap\"",
            "default": "nowrap",
            "description": "Whether children may wrap onto additional lines when the main axis runs out of room (`flex-wrap`).",
            "classes": {
              "nowrap": "primitiv-stack--nowrap",
              "wrap": "primitiv-stack--wrap"
            }
          },
          {
            "name": "justify",
            "type": "\"start\" | \"center\" | \"end\" | \"between\" | \"around\" | \"evenly\"",
            "default": "start",
            "description": "Main-axis distribution (`justify-content`), as a preset set rather than a raw CSS passthrough.",
            "classes": {
              "start": "primitiv-stack--justify-start",
              "center": "primitiv-stack--justify-center",
              "end": "primitiv-stack--justify-end",
              "between": "primitiv-stack--justify-between",
              "around": "primitiv-stack--justify-around",
              "evenly": "primitiv-stack--justify-evenly"
            }
          }
        ],
        "dataAttributes": [],
        "class": "primitiv-stack"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add stack",
    "rootClass": "primitiv-stack",
    "customProperties": [
      {
        "name": "--primitiv-stack-gap",
        "defaultsTo": "var(--primitiv-stack-gap-md)"
      }
    ],
    "dataAttributes": []
  },
  "figma": {
    "componentSetKey": "1815:59414"
  },
  "elements": {
    "package": null,
    "module": "stack",
    "version": null,
    "element": "div",
    "wrapText": false,
    "example": "<div class=\"primitiv-stack primitiv-stack--column primitiv-stack--gap-md primitiv-stack--align-stretch primitiv-stack--nowrap primitiv-stack--justify-start\">\n  <div>First</div>\n  <div>Second</div>\n  <div>Third</div>\n</div>\n",
    "api": []
  }
}
