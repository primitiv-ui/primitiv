{
  "id": "switch",
  "displayName": "Switch",
  "kind": "registry",
  "status": "stable",
  "category": "Forms",
  "description": "An on/off toggle with an optional inline label — a native switch input for an immediate binary setting.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Switch.Root",
        "extends": "HTMLInputElement",
        "props": [
          {
            "name": "checked",
            "type": "boolean",
            "required": false,
            "default": null,
            "description": "Forbidden in uncontrolled mode — use `defaultChecked` instead.\nThe controlled checked state. Must be kept in sync by the parent via\n`onCheckedChange`."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "Content of the switch — typically a single\n{@link SwitchThumbProps`Switch.Thumb`}."
          },
          {
            "name": "defaultChecked",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Checked state on first render. Defaults to `false` when omitted.\nForbidden in controlled mode — use `checked` instead."
          },
          {
            "name": "onCheckedChange",
            "type": "(checked: boolean) => void",
            "required": false,
            "default": null,
            "description": "Called with the new boolean state whenever the switch toggles. Optional\nin uncontrolled mode.\nCalled with the new boolean state whenever the user requests a toggle.\nRequired in controlled mode."
          },
          {
            "name": "ref",
            "type": "Ref<HTMLInputElement>",
            "required": false,
            "default": null,
            "description": "Allows getting a ref to the component instance.\nOnce the component unmounts, React will set `ref.current` to `null`\n(or call the ref with `null` if you passed a callback ref).\nForwarded to the underlying native `HTMLInputElement` (the real,\nvisually-hidden checkbox), not the visible track."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control size; `data-density` scales each size further."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-state",
            "value": "checked",
            "when": "checked"
          },
          {
            "name": "data-state",
            "value": "unchecked",
            "when": "unchecked"
          },
          {
            "name": "data-disabled",
            "value": "",
            "when": "disabled"
          }
        ],
        "class": "primitiv-switch"
      },
      {
        "name": "Switch.Thumb",
        "extends": "HTMLSpanElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "When `true`, render the consumer's own element as the thumb instead of the\ndefault `<span>`, merging `aria-hidden` and `data-state` onto it via the\n{@link Slot } pattern."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "Optional thumb content (rarely needed — the thumb is usually styled\npurely with CSS)."
          }
        ],
        "styledOnly": false,
        "headlessOnly": true,
        "contractProps": [],
        "dataAttributes": [],
        "class": null
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add switch",
    "rootClass": "primitiv-switch",
    "customProperties": [
      {
        "name": "--primitiv-switch-track-bg",
        "defaultsTo": "var(--primitiv-border-strong)"
      },
      {
        "name": "--primitiv-switch-track-bg-checked",
        "defaultsTo": "var(--primitiv-action-primary-default)"
      },
      {
        "name": "--primitiv-switch-track-width",
        "defaultsTo": "var(--primitiv-switch-md-track-width)"
      },
      {
        "name": "--primitiv-switch-track-height",
        "defaultsTo": "var(--primitiv-switch-md-track-height)"
      },
      {
        "name": "--primitiv-switch-track-radius",
        "defaultsTo": "var(--primitiv-radii-full)"
      },
      {
        "name": "--primitiv-switch-thumb-bg",
        "defaultsTo": "var(--primitiv-surface-default)"
      },
      {
        "name": "--primitiv-switch-thumb-size",
        "defaultsTo": "var(--primitiv-switch-md-thumb-size)"
      },
      {
        "name": "--primitiv-switch-thumb-margin",
        "defaultsTo": "var(--primitiv-switch-md-thumb-margin)"
      },
      {
        "name": "--primitiv-switch-thumb-radius",
        "defaultsTo": "var(--primitiv-radii-full)"
      },
      {
        "name": "--primitiv-switch-thumb-shadow",
        "defaultsTo": "var(--primitiv-shadow-1)"
      },
      {
        "name": "--primitiv-switch-gap",
        "defaultsTo": "var(--primitiv-choice-control-md-gap)"
      },
      {
        "name": "--primitiv-switch-label-color",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-switch-label-font-family",
        "defaultsTo": "var(--primitiv-label-md-font-family)"
      },
      {
        "name": "--primitiv-switch-label-font-size",
        "defaultsTo": "var(--primitiv-label-md-font-size)"
      },
      {
        "name": "--primitiv-switch-label-font-weight",
        "defaultsTo": "var(--primitiv-label-md-font-weight)"
      },
      {
        "name": "--primitiv-switch-label-line-height",
        "defaultsTo": "var(--primitiv-label-md-line-height)"
      }
    ],
    "dataAttributes": [
      {
        "name": "data-state",
        "value": "checked",
        "when": "checked"
      },
      {
        "name": "data-state",
        "value": "unchecked",
        "when": "unchecked"
      },
      {
        "name": "data-disabled",
        "value": "",
        "when": "disabled"
      }
    ]
  },
  "figma": {
    "componentSetKey": "315:5884"
  }
}
