{
  "id": "textarea",
  "displayName": "Textarea",
  "kind": "registry",
  "status": "stable",
  "category": "Forms",
  "description": "A multi-line text input — the framed field consumers type longer content into.",
  "headless": {
    "package": "@primitiv-ui/react",
    "importPath": "@primitiv-ui/react",
    "subComponents": [
      {
        "name": "Textarea",
        "extends": "HTMLTextAreaElement",
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "required": false,
            "default": "false",
            "description": "Renders the child element instead of a native `<textarea>`, merging all\nprops — aria-*, data-*, event handlers, ref — onto it via {@link Slot }.\nEvent handlers compose (child runs first). Use this to wrap a third-party\nautosizing textarea while keeping this component's prop contract."
          },
          {
            "name": "children",
            "type": "ReactNode",
            "required": false,
            "default": null,
            "description": "Child content. Under `asChild`, must be a single React element that\n{@link Slot } merges props onto. Not used when rendering a native\n`<textarea>` (the element's content is controlled by `value` /\n`defaultValue`, not children)."
          },
          {
            "name": "ref",
            "type": "Ref<HTMLTextAreaElement>",
            "required": false,
            "default": null,
            "description": "Forwarded to the underlying `HTMLTextAreaElement`. Under `asChild`, merged\nonto the rendered child via {@link Slot }."
          }
        ],
        "styledOnly": false,
        "headlessOnly": false,
        "contractProps": [
          {
            "name": "size",
            "type": "\"xs\" | \"sm\" | \"md\" | \"lg\" | \"xl\"",
            "default": "md",
            "description": "Control size; `data-density` scales each size further."
          }
        ],
        "dataAttributes": [
          {
            "name": "data-disabled",
            "value": "",
            "when": "disabled"
          }
        ],
        "class": "primitiv-textarea"
      }
    ]
  },
  "styled": {
    "installCommand": "primitiv add textarea",
    "rootClass": "primitiv-textarea",
    "customProperties": [
      {
        "name": "--primitiv-textarea-bg",
        "defaultsTo": "var(--primitiv-surface-default)"
      },
      {
        "name": "--primitiv-textarea-fg",
        "defaultsTo": "var(--primitiv-content-primary)"
      },
      {
        "name": "--primitiv-textarea-placeholder-color",
        "defaultsTo": "var(--primitiv-content-muted)"
      },
      {
        "name": "--primitiv-textarea-border-color",
        "defaultsTo": "var(--primitiv-border-default)"
      },
      {
        "name": "--primitiv-textarea-border-color-focus",
        "defaultsTo": "var(--primitiv-border-focus)"
      },
      {
        "name": "--primitiv-textarea-border-color-invalid",
        "defaultsTo": "var(--primitiv-border-invalid)"
      },
      {
        "name": "--primitiv-textarea-border-width",
        "defaultsTo": "var(--primitiv-framed-control-border-width)"
      },
      {
        "name": "--primitiv-textarea-radius",
        "defaultsTo": "var(--primitiv-framed-control-md-radius)"
      },
      {
        "name": "--primitiv-textarea-min-height",
        "defaultsTo": "var(--primitiv-textarea-md-min-height)"
      },
      {
        "name": "--primitiv-textarea-padding-inline",
        "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)"
      },
      {
        "name": "--primitiv-textarea-padding-block",
        "defaultsTo": "var(--primitiv-framed-control-md-padding-inline)"
      },
      {
        "name": "--primitiv-textarea-font-family",
        "defaultsTo": "var(--primitiv-body-md-font-family)"
      },
      {
        "name": "--primitiv-textarea-font-size",
        "defaultsTo": "var(--primitiv-body-md-font-size)"
      },
      {
        "name": "--primitiv-textarea-font-weight",
        "defaultsTo": "var(--primitiv-body-md-font-weight)"
      },
      {
        "name": "--primitiv-textarea-line-height",
        "defaultsTo": "var(--primitiv-body-md-line-height)"
      }
    ],
    "dataAttributes": [
      {
        "name": "data-disabled",
        "value": "",
        "when": "disabled"
      }
    ]
  },
  "figma": {
